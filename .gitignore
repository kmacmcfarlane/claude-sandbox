.idea
.DS_Store

.claude/*
!.claude/settings.json

node_modules/

# Python bytecode (scaffold-ralph/scripts test runs)
__pycache__/
*.pyc

# Consolidated layout: track config + work items, ignore state.
# (The old whole-dir /.claude-sandbox/ rule made the ! lines dead — git never
# descends into an ignored directory, so nothing under it was ever tracked.)
.claude-sandbox/env
.claude-sandbox/temp/
.claude-sandbox/ralph/
.claude-sandbox/investigations/
.claude-sandbox/reports/
.claude-sandbox/**/*.dec.*

# Go build cache for the shim-built binary
/bin/dist/
