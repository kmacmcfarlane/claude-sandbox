.idea
.DS_Store

.claude/*
!.claude/settings.json

node_modules/

# Python tooling debris (scaffold-ralph/scripts test runs)
__pycache__/
*.pyc
.pytest_cache/

# Consolidated layout (foreign-safe default): .claude-sandbox/ is a SIDECAR
# git repo — work items, investigations, config all live in its own history,
# so the whole dir stays ignored here.
/.claude-sandbox/

# Go build cache for the shim-built binary
/bin/dist/

# go build ./cmd/claude-sandbox from the repo root drops the binary here
/claude-sandbox
