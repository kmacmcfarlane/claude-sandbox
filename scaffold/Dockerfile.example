# Dockerfile — project-specific tools for claude-sandbox
#
# Place as .claude-sandbox/Dockerfile in your project (or configure the
# path via .claude-sandbox/config.yaml or environment variables).
#
# The build context is the project root, so COPY instructions reference your
# project directory.
#
# USER CONVENTION:
#   The base image's entrypoint runs as root, remaps the "claude" user to match
#   the host caller's UID/GID, then drops privileges via gosu. It also chowns
#   all non-bind-mounted files under the home directory at startup.
#
#   - Use "USER claude" for RUN steps that create files under /home/claude
#     (e.g. go install, writing to ~/.cache). pip installs into the base venv
#     run as root (see "Python packages" below); "pip install --user" fails there.
#   - Use /home/claude (not a hardcoded host path like /home/yourname) so the
#     image is portable across host users.
#   - End with "USER root" so the entrypoint has the privileges it needs.
#
# THE CLAUDE CLI AND THE SANDBOX TOOLS ARE NOT HERE AT BUILD TIME:
#   The base image contains neither Claude Code nor the sandbox's own files
#   (/opt/claude-sandbox/bin — claude-sandbox, ralph, entrypoint.sh —
#   logstream/, the Discord MCP bundle, the managed-settings hooks). The
#   launcher copies them onto this image at launch, from the claude-sandbox-cli
#   and claude-sandbox-tools images (a one-layer "cap" tagged <this-image>:run).
#   A RUN step that invokes `claude`, `claude-sandbox` or `ralph` will fail.
#   Anything needing them (plugin registration) belongs at
#   runtime. This is also why a sandbox update never rebuilds this image.
#   Do not install the CLI here either: the installer leaves state in
#   /home/claude/.claude, which the entrypoint moves into ~/.claude, and the
#   cap's COPY --link onto /home/claude/.local replaces your install anyway.
#
# TIME ZONE:
#   The launcher passes the host's zone as TZ (timezone: in config.yaml). An
#   "ENV TZ=..." here is kept under that default; a
#   "RUN ln -sf /usr/share/zoneinfo/X /etc/localtime" is NOT seen and TZ
#   overrides it: set "timezone: none" (keep this image's file) or
#   "timezone: X" in config.yaml instead.
#
# CACHE MOUNTS — share the base image's download caches:
#   The base declares BuildKit cache mounts with fixed ids. Reuse the same ids
#   here and your apt/pip/npm/go downloads are served from the same cache
#   instead of fetched again for every image on the machine:
#     --mount=type=cache,id=claude-sandbox-apt,target=/var/cache/apt,sharing=locked
#     --mount=type=cache,id=claude-sandbox-apt-lists,target=/var/lib/apt,sharing=locked
#     --mount=type=cache,id=claude-sandbox-pip,target=/root/.cache/pip
#     --mount=type=cache,id=claude-sandbox-npm,target=/root/.npm
#     --mount=type=cache,id=claude-sandbox-go-mod,target=/go/pkg/mod
#     --mount=type=cache,id=claude-sandbox-go-build,target=/root/.cache/go-build
#   Under "USER claude" the mount must be owned by that user or the step fails
#   with "permission denied": add uid=1000,gid=1000 and target it under
#   /home/claude (see the gopls example below). BuildKit creates a missing
#   PARENT of the mount target as root, so `mkdir -p` the tree as claude in a
#   step before the mount — otherwise `go` cannot create ~/go/pkg/sumdb next
#   to the mounted ~/go/pkg/mod. The base image already keeps apt's downloads
#   (docker-clean is disabled), so no extra apt config is needed.
#
# PIN VERSIONS. `@latest` re-resolves on every rebuild and turns a cache hit
# into a download plus a compile; a pinned version rebuilds only when you
# change it.

FROM claude-sandbox

# --- Go toolchain: copy it from the official image (no curl/tar layer) -------
# COPY --link --from=golang:1.25.6-bookworm /usr/local/go /usr/local/go
# ENV PATH="/usr/local/go/bin:$PATH"

# --- Go tools (gopls etc.) — install as claude user for ~/go/bin ------------
# USER claude
# RUN mkdir -p /home/claude/go/pkg/mod /home/claude/go/bin /home/claude/.cache/go-build
# RUN --mount=type=cache,id=claude-sandbox-go-mod-claude,target=/home/claude/go/pkg/mod,uid=1000,gid=1000 \
#     --mount=type=cache,id=claude-sandbox-go-build-claude,target=/home/claude/.cache/go-build,uid=1000,gid=1000 \
#     go install golang.org/x/tools/gopls@v0.23.0
# USER root
# ENV PATH="/home/claude/go/bin:$PATH"

# --- apt packages ------------------------------------------------------------
# RUN --mount=type=cache,id=claude-sandbox-apt,target=/var/cache/apt,sharing=locked \
#     --mount=type=cache,id=claude-sandbox-apt-lists,target=/var/lib/apt,sharing=locked \
#     apt-get update && apt-get install -y --no-install-recommends jq

# --- direnv: load an allowed .envrc in every shell, not just interactive ones -
# A prompt hook (`direnv hook bash|zsh`) fires only in interactive shells. The
# operator's `!` commands and Claude Code's Bash tool run NON-interactive
# shells, and the Bash tool's start-up snapshot of ~/.bashrc / ~/.zshrc keeps
# aliases, functions and shell options, not environment variables
# (code.claude.com/docs/en/tools-reference, "Bash tool behavior"). Non-
# interactive bash reads no rc file; nothing short of BASH_ENV reaches it.
# ENV BASH_ENV here is fine (only env files refuse it); the root entrypoint
# runs `bash -p`, which ignores it. It runs for every non-interactive bash,
# scripts too, and direnv itself evaluates .envrc in a bash, so the file skips
# that bash (its parent is direnv) and anything the .envrc starts
# (DIRENV_IN_ENVRC): without the guard each export starts another one until
# the container is killed, or .envrc runs twice per command. Narrower: drop
# BASH_ENV and set CLAUDE_ENV_FILE to the same file, which Claude Code runs
# before each Bash tool command only. Either way a slow .envrc slows every
# Bash tool command. The /etc/bash.bashrc hook re-exports on `cd`.
# RUN --mount=type=cache,id=claude-sandbox-apt,target=/var/cache/apt,sharing=locked \
#     --mount=type=cache,id=claude-sandbox-apt-lists,target=/var/lib/apt,sharing=locked \
#     apt-get update && apt-get install -y --no-install-recommends direnv \
#     && printf '%s\n' 'if [ -z "${DIRENV_IN_ENVRC:-}" ] && { read -r _dv_p < /proc/$PPID/comm; [ "$_dv_p" != direnv ]; } 2>/dev/null && command -v direnv >/dev/null 2>&1; then eval "$(direnv export bash 2>/dev/null)"; fi; unset _dv_p' > /etc/direnv-bash-env.sh \
#     && printf '%s\n' 'eval "$(direnv hook bash)"' >> /etc/bash.bashrc
# ENV BASH_ENV=/etc/direnv-bash-env.sh
#
# --- zsh (optional; after the direnv step) -----------------------------------
# INSTALLING ZSH SWITCHES CLAUDE CODE'S SHELL: with no bash/zsh $SHELL, Claude
# Code runs the Bash tool and `!` commands in the first working zsh, then bash.
# Pin the one you want with CLAUDE_CODE_SHELL (/usr/bin/zsh here, or /bin/bash
# to keep bash with zsh installed). zsh reads /etc/zsh/zshenv on every start,
# interactive or not, so the export goes there; /etc/zsh/zshrc re-exports on
# `cd` in interactive shells.
# RUN --mount=type=cache,id=claude-sandbox-apt,target=/var/cache/apt,sharing=locked \
#     --mount=type=cache,id=claude-sandbox-apt-lists,target=/var/lib/apt,sharing=locked \
#     apt-get update && apt-get install -y --no-install-recommends zsh \
#     && printf '%s\n' 'command -v direnv >/dev/null 2>&1 && eval "$(direnv export zsh 2>/dev/null)"' >> /etc/zsh/zshenv \
#     && printf '%s\n' 'eval "$(direnv hook zsh)"' >> /etc/zsh/zshrc
# ENV CLAUDE_CODE_SHELL=/usr/bin/zsh

# --- TypeScript / JavaScript language servers --------------------------------
# RUN --mount=type=cache,id=claude-sandbox-npm,target=/root/.npm \
#     npm install -g typescript-language-server@4.4.0 typescript@5.9.3 @vtsls/language-server@0.2.10

# --- Python packages (venv is already active from base image) ----------------
# RUN --mount=type=cache,id=claude-sandbox-pip,target=/root/.cache/pip \
#     pip install numpy==2.3.3 pandas==2.3.3

# --- Static binaries: fetch in a throwaway stage, COPY --link the result ------
# FROM debian:bookworm-slim AS tools
# RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip
# Retry downloads: a dropped HTTP/2 stream (curl exit 18) otherwise fails the build.
# A large file can resume with `-C -`. Pin the version and verify a checksum
# (`echo "<sha256>  /tmp/tf.zip" | sha256sum -c -`) where upstream publishes one.
# RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 https://releases.hashicorp.com/terraform/1.15.7/terraform_1.15.7_linux_amd64.zip -o /tmp/tf.zip \
#     && unzip -d /out /tmp/tf.zip
# FROM claude-sandbox
# COPY --link --chmod=755 --from=tools /out/terraform /usr/local/bin/terraform

# --- Files under /home/claude (use USER claude so they're owned correctly) ---
# USER claude
# RUN mkdir -p /home/claude/.cache/myapp \
#     && echo "hello" > /home/claude/.cache/myapp/config
# USER root
