.idea
.DS_Store
.claude
# The sandbox's own sidecar: work items, investigations, ralph runlogs and a
# nested .git. Never needed by a build (`.claude` above is an exact-component
# match and does not cover it).
.claude-sandbox
node_modules
LICENSE
README.md
.gitignore
.dockerignore
test/
hooks/
package.json
# Build artifacts: the root-level Go binary (from `go build` at the root) and the
# shim's build output + Go module/build caches. The builder stage compiles from
# source, so nothing here is needed by any image build.
claude-sandbox
bin/dist/
