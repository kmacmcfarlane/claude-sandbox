#!/bin/bash
#
# notify-webhook — the body of the baked Notification hook (CS-LNCH-111).
#
# Claude Code runs this with the Notification hook payload on stdin. It posts
# one Discord message naming the session that is waiting, so an operator with a
# dozen concurrent sandboxes can go straight to the right one instead of
# reading "Claude Code needs your input" a dozen times.
#
# Contract:
#   - never fails a session: every path exits 0, and the drop-in still appends
#     "|| true" (notification-hooks.json).
#   - silent and instant when CLAUDE_NOTIFICATION_WEBHOOK_URL is unset.
#   - no docker, no IPC, no network beyond the single curl. Only cat, jq and
#     curl are run; everything else is a bash builtin. The webhook URL reaches
#     curl through a config file on a pipe (-K), never through argv, so it
#     does not show up in ps.
#   - reads exactly one file: this session's own peer-registry record,
#     <config dir>/sessions/$CLAUDE_PID.json, and only takes its "name" when
#     the record's sessionId is this session's. The directory is never listed
#     and no other session's record is opened.
#   - degrades one field at a time, and to the single line this hook posted
#     before whenever nothing at all identifies the session (no env, no
#     payload, no jq).
#
# What it may say: the session's name (as /peers shows it), its instance noun,
# the project directory's basename and — in the attach command — its path with
# $HOME shortened to ~, the container name, the notification kind, and — for a
# permission prompt only — the CLI's own one-line message, which names the
# tool and nothing else. Never an env value, a token, the webhook URL, any
# other path, or anything from the transcript.
#
# Markdown: every interpolated value sits inside a code span (backticks are
# stripped from them first), so a session named "[x](http://y)" or "_a_"
# renders as text, and the post sets flags=4 (SUPPRESS_EMBEDS) and
# allowed_mentions.parse=[] so nothing unfurls and nothing pings.
#
# Hook stdin (Claude Code 2.1.281/2.1.282 bundle, Notification event):
#   session_id, transcript_path, cwd, hook_event_name:"Notification", message,
#   notification_type, plus scratchpad_dir, prompt_id and agent_type when they
#   apply (and title, which no call site sets). There is NO session name in
#   it. The hook's environment carries CLAUDE_PID (the claude process) and
#   CLAUDE_CODE_SESSION_ID, which is how the registry record is found.
# The messages matched by notification-hooks.json ("idle_prompt|permission_prompt",
# matched against notification_type) are fixed CLI strings:
#   idle_prompt       "Claude is waiting for your input"
#   permission_prompt "Claude needs your permission to use <tool>"
#
# Launcher-provided env (CS-LNCH-111, CS-SESS-075): CLAUDE_SANDBOX_INSTANCE,
# CLAUDE_SANDBOX_CONTAINER, CLAUDE_SANDBOX_MODE (claude|ralph|headless),
# CLAUDE_SANDBOX_JOINED=1 on a joined session, CLAUDE_SANDBOX_PROJECT_DIR.

set -u

url=${CLAUDE_NOTIFICATION_WEBHOOK_URL:-}
[ -n "$url" ] || exit 0

fallback='🔔 Claude Code needs your input'

# The braces also silence bash's own "ignored null byte" warning.
{ payload=$(cat); } 2>/dev/null || payload=''

# Pass 1: normalize the payload to a compact object (anything unparseable
# becomes {}, so the env-derived identity below still reaches Discord), plus
# the session id. jq -c escapes every control character, so each value is
# exactly one line.
head2=$(printf '%s' "$payload" | jq -r '
  (if type == "object" then . else {} end) as $p
  | [ ($p | tojson),
      (($p.session_id // "") | tostring | gsub("[\u0000-\u001f\u007f]"; "")) ]
  | .[]' 2>/dev/null) || head2=''
parsed=${head2%%$'\n'*}
sid=''
[[ $head2 == *$'\n'* ]] && sid=${head2#*$'\n'}
[ -n "$parsed" ] || parsed='{}'
[ -n "$sid" ] || sid=${CLAUDE_CODE_SESSION_ID:-}

# The session's name as peers see it: the "name" of this session's own
# registry record. CLAUDE_PID is the claude process that runs this hook; the
# record is trusted only when its sessionId is this session's, so a stale
# record left by an earlier process with the same pid names nothing.
name=''
pid=${CLAUDE_PID:-}
if [ -n "$sid" ] && [[ $pid =~ ^[0-9]+$ ]]; then
    record="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/sessions/$pid.json"
    if [ -r "$record" ]; then
        name=$(jq -r --arg s "$sid" \
            'if type == "object" and .sessionId == $s then (.name // empty) | tostring else empty end' \
            "$record" 2>/dev/null) || name=''
    fi
fi

# Pass 2: the whole message, built in jq so every interpolated value is
# truncated by codepoint (not byte) and JSON-escaped exactly once.
content=$(printf '%s' "$parsed" | jq -r \
    --arg name "$name" \
    --arg instance "${CLAUDE_SANDBOX_INSTANCE:-}" \
    --arg container "${CLAUDE_SANDBOX_CONTAINER:-}" \
    --arg projectdir "${CLAUDE_SANDBOX_PROJECT_DIR:-}" \
    --arg home "${HOME:-}" \
    --arg mode "${CLAUDE_SANDBOX_MODE:-}" \
    --arg joined "${CLAUDE_SANDBOX_JOINED:-}" \
    --arg fallback "$fallback" '
  # Backticks would break the code spans below; control characters would break
  # the line structure. Both become spaces.
  def clean($n): (. // "") | tostring
    | gsub("[\u0000-\u001f\u007f`]"; " ") | .[0:$n] | sub("[ ]+$"; "");

  ((.notification_type // "") | clean(40))                              as $kind
  | (if $kind == "permission_prompt" then (.message // "") | clean(160)
     else "" end)                                                       as $msg
  | ((if $projectdir != "" then $projectdir else (.cwd // "") end)
     | tostring | split("/") | map(select(. != "")) | (last // "")
     | clean(80))                                                       as $project
  # The project path for a copy-pasteable "cd <path> && claude-sandbox
  # --attach=<noun>" (attach looks only at the sessions of the current project,
  # CS-SESS-030): $HOME shortened to ~, shell-quoted when it needs it, and
  # omitted rather than mangled when it is not absolute, is too long, or holds
  # a character a code span or a single line cannot carry — or a backslash,
  # which fish honours inside single quotes (so no quoting is safe for it).
  | def shq: if test("^[A-Za-z0-9._/+@:=,-]+$") then .
             else "\u0027" + gsub("\u0027"; "\u0027\\\u0027\u0027") + "\u0027" end;
    ($projectdir
     | if startswith("/") and length <= 300 and (test("[\u0000-\u001f\u007f`\\\\]") | not)
       then (if $home != "" and $home != "/" and . == $home then "~"
             elif $home != "" and $home != "/" and startswith($home + "/")
               then "~/" + (.[($home | length) + 1:] | shq)
             else shq end)
       else "" end)                                                     as $cdpath
  | ($name | clean(80))                                                 as $who
  | ($instance | clean(40))                                             as $noun
  | ($container | clean(120))                                           as $ctr
  | (if   $kind == "permission_prompt" then "permission prompt"
     elif $kind == "idle_prompt"       then "idle"
     elif $kind == ""                  then "needs your input"
     else ($kind | gsub("_"; " ")) end)                                 as $klabel
  | (if   $who != "" and $noun != "" then "**`\($who)`** (`\($noun)`)"
     elif $who != ""                 then "**`\($who)`**"
     elif $noun != ""                then "**`\($noun)`**"
     else "" end)                                                       as $session
  # How to reach it. Attach reaches a container primary session; a joined
  # session (docker exec) and a headless one cannot be attached, so they are
  # named, not offered a command that would land somewhere else.
  | (if $ctr != "" then " · container `\($ctr)`" else "" end)          as $ctrtail
  | (if   $joined == "1"          then "Joined session (not attachable)" + $ctrtail
     elif $mode == "headless"     then "Headless session (SDK client)" + $ctrtail
     # A noun the launcher could have picked, or no pasteable command at all.
     elif ($noun | test("^[a-z0-9-]+$") | not) then
       (if $ctr != "" then "Container: `\($ctr)`" else "" end)
     elif $cdpath != ""
       then "Attach: `cd \($cdpath) && claude-sandbox --attach=\($noun)`" + $ctrtail
     else "Attach: `claude-sandbox --attach=\($noun)`" + $ctrtail
     end)                                                               as $reach
  | if $session == "" and $project == "" and $reach == "" then $fallback
    else
      ([ "🔔 " + $klabel ]
       + (if $session != "" then [$session] else [] end)
       + (if $project != "" then ["project `\($project)`"] else [] end)
       | join(" · ")) as $header
      | ([$header]
         + (if $msg != "" then ["> `" + $msg + "`"] else [] end)
         + (if $reach != "" then [$reach] else [] end)
         | join("\n"))
    end' 2>/dev/null) || content=''
[ -n "$content" ] || content=$fallback

# flags 4 = SUPPRESS_EMBEDS; allowed_mentions.parse=[] so no text can ping.
body=$(jq -nc --arg c "$content" '{content: $c, allowed_mentions: {parse: []}, flags: 4}' 2>/dev/null) \
    || body='{"content":"🔔 Claude Code needs your input","allowed_mentions":{"parse":[]},"flags":4}'

# The URL goes to curl as a config file on a pipe (printf is a builtin, so it
# is never in any process's argv), with globoff so {} and [] are literal;
# quotes and backslashes are escaped for the config syntax and line breaks dropped. The body comes on stdin, verbatim.
u=${url//$'\n'/}
u=${u//$'\r'/}
u=${u//\\/\\\\}
u=${u//\"/\\\"}
printf '%s' "$body" | curl -sS -m 10 -X POST \
    -H 'Content-Type: application/json' --data-binary @- \
    -K <(printf 'globoff\nurl = "%s"\n' "$u") >/dev/null 2>&1

exit 0
