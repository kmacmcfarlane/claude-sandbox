#!/usr/bin/env bash
#
# claude-sandbox — thin bootstrap shim.
#
# The launcher is a Go binary (cmd/claude-sandbox). This shim keeps the
# clone-and-run install model: it (re)builds the binary when sources are newer
# than the cached build — using the host Go toolchain when available, else a
# throwaway `docker run golang` so the host needs only bash + docker — then
# execs it. All behavior lives in the binary (see spec/*.feature).
#
set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"
BIN_DIR="$REPO_ROOT/bin/dist"
BIN="$BIN_DIR/claude-sandbox"
GO_IMAGE="golang:1.25-bookworm"

# Sources whose changes require a rebuild of the binary.
SOURCES=(cmd internal assets.go go.mod go.sum scaffold scaffold-ralph
         container-context.md notification-hooks.json mcp-servers.json PROMPT_RALPH.md)

# stale: the binary is missing, or a source is newer than it.
stale() {
    [ -x "$BIN" ] || return 0
    local src p
    for src in "${SOURCES[@]}"; do
        p="$REPO_ROOT/$src"
        [ -e "$p" ] || continue
        if [ -n "$(find "$p" -newer "$BIN" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

# Shell completion (spec/completion.feature CS-COMP-022/023): the generated
# scripts call these hidden commands on every TAB. A keystroke must never block
# on a compile or a docker image pull, so serve them from whatever binary is
# already built — slightly stale completions beat a hung prompt — and exit
# quietly if nothing has been built yet.
case "${1-}" in
    __complete | __completeNoDesc)
        [ -x "$BIN" ] || exit 1
        export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
        exec -a claude-sandbox "$BIN" "$@"
        ;;
    tmux)
        # The tmux-resurrect save hook (spec/tmux.feature CS-TMUX-003) runs
        # inside every save, continuum's minute autosave included: it must
        # never build (unbounded, and it prints) and never print. A stale
        # binary is skipped too, not run: one from before the hook existed
        # would read "tmux save <file>" as a prompt and launch a session. The
        # next ordinary launch rebuilds, and saves pick up again.
        if [ "${2-}" = save ]; then
            stale && exit 0
            export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
            exec -a claude-sandbox "$BIN" "$@" >/dev/null 2>&1
        fi
        ;;
esac

needs_build=false
if stale; then
    needs_build=true
fi

if [ "$needs_build" = true ]; then
    mkdir -p "$BIN_DIR"
    if command -v go >/dev/null 2>&1; then
        echo "Building claude-sandbox binary (host go)..." >&2
        # Build output goes to stderr: stdout belongs to claude in headless mode.
        (cd "$REPO_ROOT" && CGO_ENABLED=0 go build -o "$BIN" ./cmd/claude-sandbox) >&2
    else
        echo "Building claude-sandbox binary (docker $GO_IMAGE)..." >&2
        # Persist the build AND module caches under bin/dist/ (gitignored), so a
        # throwaway build container downloads each dependency only once.
        # stdout goes to stderr: in headless mode stdout is claude's stream-json
        # (a first pull prints progress there).
        mkdir -p "$BIN_DIR/gocache" "$BIN_DIR/gomodcache"
        docker run --rm \
            -u "$(id -u):$(id -g)" \
            -e HOME=/tmp -e CGO_ENABLED=0 \
            -e GOCACHE=/src/bin/dist/gocache \
            -e GOMODCACHE=/src/bin/dist/gomodcache \
            -v "$REPO_ROOT:/src" -w /src \
            "$GO_IMAGE" go build -o bin/dist/claude-sandbox ./cmd/claude-sandbox >&2
    fi
fi

export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
# argv[0] is "claude-sandbox", not the bin/dist path (spec/tmux.feature
# CS-TMUX-001/002): tmux-resurrect saves the full command line and its
# @resurrect-processes entries match only the first word (`^name ` /
# `^name$`), which the bin/dist path (possibly containing a space) never
# matched. The binary never derives anything from argv[0] but the "ralph"
# switch; its repo root comes from CLAUDE_SANDBOX_REPO_ROOT.
exec -a claude-sandbox "$BIN" "$@"
