#!/usr/bin/env bash
#
# Run Claude Code inside a sandboxed Docker container.
#
# Usage:
#   claude-sandbox                          # launch claude interactively in $PWD
#   claude-sandbox --resume                 # pass args through to claude
#   claude-sandbox --dangerous              # skip permission prompts
#   claude-sandbox --docker-socket           # mount the host Docker socket
#   claude-sandbox --aws                     # mount ~/.aws/ read-only
#   claude-sandbox --git                     # mount ~/.gitconfig read-only
#   claude-sandbox --ssh                     # mount ~/.ssh/ read-only
#   claude-sandbox --ralph [ralph-args]     # launch the ralph loop runner
#   claude-sandbox --ralph --limit 5        # run ralph for 5 iterations
#   claude-sandbox init                     # bootstrap .claude-sandbox/ and exit
#   claude-sandbox init-ralph               # bootstrap + seed ralph scaffolding
#   PROJECT_DIR=/other claude-sandbox       # launch claude in /other
#
# The project is mounted at its REAL host path inside the container so that
# docker compose volumes (which the host daemon resolves) work correctly.
#
set -euo  pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"
BASE_IMAGE_NAME="claude-sandbox"

# Single resolver for "foreign" file locations under .claude-sandbox/.
# See bin/lib/paths.sh.
source "$(dirname "$REAL_PATH")/lib/paths.sh"

# Version of the running scripts (git describe of the checkout). Baked into the
# image at build time and surfaced via --version.
CLAUDE_SANDBOX_VERSION="$(git -C "$REPO_ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)"

print_version() {
    echo "claude-sandbox $CLAUDE_SANDBOX_VERSION  (host scripts: $REPO_ROOT)"
    if docker image inspect "$BASE_IMAGE_NAME" >/dev/null 2>&1; then
        local baked created
        baked="$(docker image inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$BASE_IMAGE_NAME" 2>/dev/null)"
        created="$(docker image inspect -f '{{ .Created }}' "$BASE_IMAGE_NAME" 2>/dev/null | cut -dT -f1)"
        echo "  image:        ${baked:-unknown}  (built ${created:-?})"
        if [ -n "$baked" ] && [ "$baked" != "$CLAUDE_SANDBOX_VERSION" ]; then
            echo "  note: image differs from host scripts — it will auto-rebuild on next launch (or run --rebuild)."
        fi
    else
        echo "  image:        (not built yet)"
    fi
}

# Walk parent directories (direnv-style) looking for a file.
# Usage: find_up <start_dir> <filename>
# Prints the full path if found, empty string otherwise.
find_up() {
    local dir="$1" name="$2"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/$name" ]; then
            echo "$dir/$name"
            return
        fi
        dir="$(dirname "$dir")"
    done
}

# ---------------------------------------------------------------------------
# Parse claude-sandbox flags; remaining args pass through to claude/ralph
# ---------------------------------------------------------------------------
RALPH_MODE=false
LIMIT=""
SKIP_PERMISSIONS=""

# Host access flags — CLI overrides (empty = not set by CLI)
CLI_SSH=""
CLI_GIT=""
CLI_DOCKER_SOCKET=""
CLI_AWS=""

# Model override (forwarded to claude/ralph as --model)
CLI_MODEL=""

# Rebuild control
FORCE_REBUILD=false
NO_UPDATE_CHECK="${CLAUDE_SANDBOX_NO_UPDATE_CHECK:-false}"

# Bootstrap control (`init` / `init-ralph` subcommands). CLI_TRACK_IN_HOST is
# empty unless --track-in-host / --no-track-in-host is passed (skips the prompt).
INIT_MODE=false
INIT_RALPH=false
CLI_TRACK_IN_HOST=""

usage() {
    cat <<'EOF'
Usage:
  claude-sandbox                          # launch claude interactively in $PWD
  claude-sandbox --resume                 # pass args through to claude
  claude-sandbox --dangerous              # skip permission prompts
  claude-sandbox --docker-socket          # mount the host Docker socket
  claude-sandbox --aws                    # mount ~/.aws/ read-only
  claude-sandbox --git                    # mount ~/.gitconfig read-only
  claude-sandbox --ssh                    # mount ~/.ssh/ read-only
  claude-sandbox --ralph [ralph-args]     # launch the ralph loop runner
  claude-sandbox --ralph --limit 5        # run ralph for 5 iterations
  claude-sandbox init                     # bootstrap .claude-sandbox/ (config, env, gitignore)
  claude-sandbox init-ralph               # bootstrap + seed ralph agent scaffolding
  PROJECT_DIR=/other claude-sandbox       # launch claude in /other

Commands (bootstrap the project, then exit — launcher flags do not apply):
  init                      Bootstrap .claude-sandbox/ in the project (config, env, gitignore, sidecar)
  init-ralph                Like init, plus seed ralph agent/ + scripts/ scaffolding
     --track-in-host          set trackInHost: true  (skip the interactive prompt)
     --no-track-in-host       set trackInHost: false (skip the interactive prompt)

Options:
  --help, -h                Show this help message and exit
  --version                 Show claude-sandbox version (host scripts + baked image) and exit
  --ralph                   Launch the ralph loop runner instead of interactive claude
  --limit N                 Run ralph for N iterations (only valid with --ralph)
  --model MODEL             Model to use (alias like 'opus' or full ID like 'claude-opus-4-8')
  --dangerous               Skip permission prompts (--dangerously-skip-permissions)
  --rebuild                 Force rebuild of base and child images
  --no-update-check         Skip Claude Code version check
  --docker-socket           Mount the host Docker socket into the container
  --aws                     Mount ~/.aws/ read-only into the container
  --git                     Mount ~/.gitconfig read-only into the container
  --ssh                     Mount ~/.ssh/ read-only into the container

Environment variables:
  PROJECT_DIR                             Override the project directory (default: $PWD)
  CLAUDE_CONFIG_DIR                       Override the Claude config directory
  CLAUDE_SANDBOX_BASE_ONLY=1              Skip child Dockerfile detection
  CLAUDE_SANDBOX_DOCKERFILE_DIR           Override child Dockerfile directory
  CLAUDE_SANDBOX_DOCKERFILE               Override child Dockerfile name
  CLAUDE_SANDBOX_HOST_ACCESS_SSH_ENABLED  Enable SSH mount via env var
  CLAUDE_SANDBOX_HOST_ACCESS_GIT_ENABLED  Enable git mount via env var
  CLAUDE_SANDBOX_HOST_ACCESS_DOCKER_SOCKET_ENABLED  Enable Docker socket mount via env var
  CLAUDE_SANDBOX_HOST_ACCESS_AWS_ENABLED  Enable AWS mount via env var
  CLAUDE_SANDBOX_NO_UPDATE_CHECK          Skip Claude Code version check

The project is mounted at its REAL host path inside the container so that
docker compose volumes (which the host daemon resolves) work correctly.
EOF
}

# ---------------------------------------------------------------------------
# Subcommands: `init` / `init-ralph` bootstrap the project and exit. They are
# positional (must be the first argument) and take only their own options —
# launcher and claude flags do not apply.
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "init" || "${1:-}" == "init-ralph" ]]; then
    [[ "$1" == "init-ralph" ]] && INIT_RALPH=true
    INIT_MODE=true
    _subcmd="$1"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --track-in-host)    CLI_TRACK_IN_HOST=true; shift ;;
            --no-track-in-host) CLI_TRACK_IN_HOST=false; shift ;;
            --help|-h)          usage; exit 0 ;;
            *)
                echo "Error: 'claude-sandbox $_subcmd' does not accept '$1'" >&2
                echo "       (valid options: --track-in-host, --no-track-in-host)" >&2
                exit 2 ;;
        esac
    done
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage; exit 0 ;;
        --version)
            print_version; exit 0 ;;
        --ralph)
            RALPH_MODE=true; shift ;;
        --limit)
            LIMIT="${2:-}"
            if [[ -z "$LIMIT" ]]; then
                echo "Error: --limit requires a value" >&2; exit 2
            fi
            shift 2 ;;
        --model)
            CLI_MODEL="${2:-}"
            if [[ -z "$CLI_MODEL" ]]; then
                echo "Error: --model requires a value" >&2; exit 2
            fi
            shift 2 ;;
        --rebuild)
            FORCE_REBUILD=true; shift ;;
        --no-update-check)
            NO_UPDATE_CHECK=true; shift ;;
        --dangerous|--dangerously-skip-permissions)
            SKIP_PERMISSIONS="--dangerously-skip-permissions"; shift ;;
        --host-access-ssh-enabled|--ssh)
            CLI_SSH=true; shift ;;
        --host-access-git-enabled|--git)
            CLI_GIT=true; shift ;;
        --host-access-docker-socket-enabled|--docker-socket)
            CLI_DOCKER_SOCKET=true; shift ;;
        --host-access-aws-enabled|--aws)
            CLI_AWS=true; shift ;;
        --)
            shift; break ;;
        --*)
            # Only allow known claude CLI flags through; reject anything else
            KNOWN_PASSTHROUGH="--resume --continue --verbose --output-format --allowedTools --disallowTools --permission-prompt-tool --mcp-config --permission-mode --append-system-prompt --system-prompt --max-turns --print --input-format --model --fallback-model"
            for _pt in $KNOWN_PASSTHROUGH; do
                if [[ "$1" = "$_pt" ]]; then break 2; fi
            done
            echo "Error: unknown flag '$1'" >&2; exit 2 ;;
        *)
            break ;;
    esac
done

if [[ -n "$LIMIT" && "$RALPH_MODE" = false ]]; then
    echo "Error: --limit is only valid with --ralph" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# Resolve project directory (must be absolute for the same-path mount trick)
# ---------------------------------------------------------------------------
PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

# ---------------------------------------------------------------------------
# Bootstrap mode (`init` / `init-ralph` subcommands): set up .claude-sandbox/ and exit.
# Idempotent — never overwrites an existing config, env, or scaffold file.
# ---------------------------------------------------------------------------
do_init() {
    local sb config env_file
    sb="$(cs_sandbox_dir "$PROJECT_DIR")"
    config="$sb/config.yaml"
    env_file="$sb/env"
    mkdir -p "$sb"

    # Configs cascade (root → project, more local wins), so the seeded local
    # config is SPARSE — fully commented — and overrides nothing until the user
    # uncomments a key. Upstream catch-all configs keep applying as defaults.
    # Detect whether any ancestor already defines trackInHost (search from the
    # parent so the project's own file is excluded).
    local upstream_track=""
    local -a upstream_configs=()
    mapfile -t upstream_configs < <(cs_collect_up "$(dirname "$PROJECT_DIR")" config)
    if [ ${#upstream_configs[@]} -gt 0 ] && \
       grep -Eqh '^[[:space:]]*trackInHost:[[:space:]]*(true|false)([[:space:]]|$)' "${upstream_configs[@]}" 2>/dev/null; then
        upstream_track="$(cs_cascade_track_in_host "${upstream_configs[@]}")"
    fi

    # Resolve the local trackInHost line: explicit CLI flag always wins; when an
    # ancestor defines it, inherit (write nothing locally); otherwise prompt.
    local track="$CLI_TRACK_IN_HOST"
    if [ -z "$track" ] && [ -z "$upstream_track" ] && [ ! -f "$config" ]; then
        track="$(cs_prompt_track_in_host)"
    fi

    # --- config (sparse seed) ---
    if [ -f "$config" ]; then
        if [ -n "$CLI_TRACK_IN_HOST" ]; then
            # Explicit flag on an existing config: keep the file consistent with
            # the layout we're about to (re)build.
            cs_set_track_in_host "$config" "$CLI_TRACK_IN_HOST"
            echo "  updated  config.yaml (trackInHost: $CLI_TRACK_IN_HOST)"
        else
            echo "  skipped  config.yaml (exists)"
        fi
    else
        cp "$REPO_ROOT/scaffold/config.yaml" "$config"
        if [ -n "$track" ]; then
            cs_set_track_in_host "$config" "$track"
            echo "  created  config.yaml (sparse; trackInHost: $track)"
        else
            echo "  created  config.yaml (sparse; trackInHost inherited: $upstream_track)"
        fi
    fi

    # --- env (sparse seed; env files layer, later wins) ---
    if [ -f "$env_file" ]; then
        echo "  skipped  env (exists)"
    else
        cp "$REPO_ROOT/scaffold/env" "$env_file"
        echo "  created  env"
    fi

    # The child Dockerfile is optional — seed it as .example so it stays inactive
    # until the user renames it to .claude-sandbox/Dockerfile.
    if [ -e "$sb/Dockerfile" ] || [ -e "$sb/Dockerfile.example" ]; then
        echo "  skipped  Dockerfile.example (exists)"
    else
        cp "$REPO_ROOT/scaffold/Dockerfile.example" "$sb/Dockerfile.example"
        echo "  created  Dockerfile.example (rename to Dockerfile to activate)"
    fi

    # Skeleton, seeded CLAUDE.md, host .gitignore, sidecar repo. Effective
    # trackInHost = most-local definition across the full cascade (local file
    # included), CLI flag first. grep-based so `init` works before yq exists.
    local effective_track
    if [ -n "$CLI_TRACK_IN_HOST" ]; then
        effective_track="$CLI_TRACK_IN_HOST"
    else
        local -a all_configs=()
        mapfile -t all_configs < <(cs_collect_up "$PROJECT_DIR" config)
        effective_track="$(cs_cascade_track_in_host "${all_configs[@]}")"
    fi
    cs_setup_layout "$PROJECT_DIR" "$effective_track"
}

if [ "$INIT_MODE" = true ]; then
    echo "Initializing .claude-sandbox/ in $PROJECT_DIR"
    do_init
    if [ "$INIT_RALPH" = true ]; then
        cs_seed_ralph_scaffold "$PROJECT_DIR" "$REPO_ROOT/scaffold-ralph"
    fi

    echo
    echo "Done. Next steps:"
    echo "  1. Add secrets / env vars to .claude-sandbox/env (e.g. DISCORD_WEBHOOK_URL, API keys)"
    echo "  2. Review .claude-sandbox/config.yaml — host access, mounts, model, memoryLimit"
    echo "  3. (optional) Rename .claude-sandbox/Dockerfile.example → Dockerfile and add project tools (FROM claude-sandbox)"
    if [ "$INIT_RALPH" = true ]; then
        echo "  4. Fill .claude-sandbox/agent/PRD.md and DEVELOPMENT_PRACTICES.md / TEST_PRACTICES.md"
        echo "  5. Groom the backlog: python3 .claude-sandbox/scripts/backlog/backlog.py add"
        echo
        echo "Run the loop:  claude-sandbox --ralph"
        echo "Stop it:       touch .claude-sandbox/ralph/stop"
    else
        echo
        echo "Launch:  claude-sandbox"
    fi
    exit 0
fi

# ---------------------------------------------------------------------------
# Detect host IDs for permission mapping
# ---------------------------------------------------------------------------
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

# ---------------------------------------------------------------------------
# Build base image if needed (must happen before volume assembly which uses it)
# ---------------------------------------------------------------------------
BASE_NEEDS_BUILD=false
if [ "$FORCE_REBUILD" = true ]; then
    BASE_NEEDS_BUILD=true
elif ! docker image inspect "$BASE_IMAGE_NAME" >/dev/null 2>&1; then
    BASE_NEEDS_BUILD=true
else
    # Compare Dockerfile mtime against image creation time via a temp marker file
    _img_created=$(docker image inspect -f '{{.Created}}' "$BASE_IMAGE_NAME" 2>/dev/null || echo "")
    if [ -n "$_img_created" ]; then
        _marker=$(mktemp)
        touch -d "$_img_created" "$_marker" 2>/dev/null || true
        if [ "$REPO_ROOT/Dockerfile" -nt "$_marker" ]; then
            BASE_NEEDS_BUILD=true
        elif [ -n "$(find "$REPO_ROOT/bin" "$REPO_ROOT/logstream" "$REPO_ROOT/entrypoint.sh" \
                          "$REPO_ROOT/PROMPT_RALPH.md" "$REPO_ROOT/mcp" \
                          -newer "$_marker" -type f -print -quit 2>/dev/null)" ]; then
            # Baked scripts/sources changed since the image was built — rebuild so
            # the container runs the current bin/ralph, logstream, entrypoint, etc.
            echo "Baked sources changed since last build — rebuilding base image."
            BASE_NEEDS_BUILD=true
        fi
        rm -f "$_marker"
    fi
fi

if [ "$BASE_NEEDS_BUILD" = true ]; then
    echo "Building $BASE_IMAGE_NAME base image ($CLAUDE_SANDBOX_VERSION)..."
    BUILD_ARGS=(-t "$BASE_IMAGE_NAME" --build-arg "CLAUDE_SANDBOX_VERSION=$CLAUDE_SANDBOX_VERSION")
    [[ "$FORCE_REBUILD" = true ]] && BUILD_ARGS+=(--no-cache)
    docker build "${BUILD_ARGS[@]}" "$REPO_ROOT"
fi

# ---------------------------------------------------------------------------
# Check for Claude Code updates (skip with --no-update-check or env var)
# ---------------------------------------------------------------------------
if [ "$NO_UPDATE_CHECK" != "true" ] && [ "$NO_UPDATE_CHECK" != "1" ] && [ "$BASE_NEEDS_BUILD" = false ]; then
    BAKED_VERSION=$(docker run --rm --entrypoint cat "$BASE_IMAGE_NAME" /opt/claude-sandbox/claude-version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "")
    LATEST_VERSION=$(npm view @anthropic-ai/claude-code version 2>/dev/null || echo "")

    if [[ -n "$BAKED_VERSION" && -n "$LATEST_VERSION" && "$BAKED_VERSION" != "$LATEST_VERSION" ]]; then
        echo ""
        echo "Claude Code update available: $BAKED_VERSION → $LATEST_VERSION"
        read -r -t 5 -p "Rebuild base image to update? [y/N] " answer </dev/tty || true
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            echo "Rebuilding $BASE_IMAGE_NAME base image..."
            docker build --no-cache -t "$BASE_IMAGE_NAME" --build-arg "CLAUDE_SANDBOX_VERSION=$CLAUDE_SANDBOX_VERSION" "$REPO_ROOT"
            BASE_NEEDS_BUILD=true  # trigger child rebuild too
        fi
        echo ""
    fi
fi

# ---------------------------------------------------------------------------
# Assemble volume mounts
# ---------------------------------------------------------------------------
VOLUMES=(
    # Mount project at its real host path so docker-in-docker volume paths match
    -v "$PROJECT_DIR:$PROJECT_DIR"
)

# Claude Code config directory (auth tokens, project memories, settings)
# Mounted at its real host path so absolute paths recorded by Claude Code
# (e.g. plugin installPath values) resolve identically inside the container.
CLAUDE_CONFIG_HOST="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [ -d "$CLAUDE_CONFIG_HOST" ]; then
    VOLUMES+=(-v "$CLAUDE_CONFIG_HOST:$CLAUDE_CONFIG_HOST")
fi

# Share the host's direnv allow-records into the container READ-ONLY so an .envrc
# you allowed on the host also loads in the agent's shells.
#
# SECURITY: :ro is deliberate. A writable mount would let the sandboxed agent
# forge a direnv allow-record, which direnv on the HOST would then trust to
# auto-run an attacker-controlled .envrc outside the sandbox. So `direnv allow`
# must be run on the host — the container can read approvals, never grant them.
#
# entrypoint.sh merges /home/claude into $HOME around pre-created mount parents,
# so mounting under ~/.local no longer hides the relocated claude binary.
# No-op when direnv isn't used (the dir only exists once you've run direnv).
DIRENV_DATA="$HOME/.local/share/direnv"
if [ -d "$DIRENV_DATA" ]; then
    VOLUMES+=(-v "$DIRENV_DATA:$DIRENV_DATA:ro")
fi


# Merge host CLAUDE.md with container context for in-container awareness
CLAUDE_MD_TMP=$(mktemp)
SETTINGS_TMP=$(mktemp)
MCP_TMP=$(mktemp)
trap "rm -f '$CLAUDE_MD_TMP' '$SETTINGS_TMP' '$MCP_TMP'" EXIT
cat "$CLAUDE_CONFIG_HOST/CLAUDE.md" 2>/dev/null >> "$CLAUDE_MD_TMP" || true
printf '\n' >> "$CLAUDE_MD_TMP"
cat "$REPO_ROOT/container-context.md" >> "$CLAUDE_MD_TMP"
VOLUMES+=(-v "$CLAUDE_MD_TMP:$CLAUDE_CONFIG_HOST/CLAUDE.md:ro")

# Merge notification hooks into user settings (shadowed so host file is untouched)
HOST_SETTINGS="$CLAUDE_CONFIG_HOST/settings.json"
HOOKS_FRAGMENT="$REPO_ROOT/notification-hooks.json"
if [ -f "$HOST_SETTINGS" ] && [ -f "$HOOKS_FRAGMENT" ]; then
    docker run --rm \
        -v "$HOST_SETTINGS:/input.json:ro" \
        -v "$HOOKS_FRAGMENT:/hooks.json:ro" \
        "$BASE_IMAGE_NAME" node -e '
            const a = require("/input.json");
            const b = require("/hooks.json");
            console.log(JSON.stringify({ ...a, ...b }, null, 2));
        ' > "$SETTINGS_TMP"
    VOLUMES+=(-v "$SETTINGS_TMP:$CLAUDE_CONFIG_HOST/settings.json")
elif [ -f "$HOOKS_FRAGMENT" ]; then
    # No host settings.json — use hooks fragment as-is
    cp "$HOOKS_FRAGMENT" "$SETTINGS_TMP"
    VOLUMES+=(-v "$SETTINGS_TMP:$CLAUDE_CONFIG_HOST/settings.json")
fi

# Sibling files alongside the config directory (.claude.json, .mcp.json).
# Mirrors the $HOME pattern: $HOME/.claude/ sits next to $HOME/.claude.json
# and $HOME/.mcp.json. When CLAUDE_CONFIG_DIR relocates the config dir,
# the same sibling relationship applies at the parent of that directory.
CONFIG_PARENT="$(dirname "$CLAUDE_CONFIG_HOST")"
if [ -f "$CONFIG_PARENT/.claude.json" ]; then
    VOLUMES+=(-v "$CONFIG_PARENT/.claude.json:$CONFIG_PARENT/.claude.json")
fi
# Merge sandbox MCP servers into user's .mcp.json (shadowed read-only)
MCP_FRAGMENT="$REPO_ROOT/mcp-servers.json"
HOST_MCP="$CONFIG_PARENT/.mcp.json"
if [ -f "$HOST_MCP" ] && [ -f "$MCP_FRAGMENT" ]; then
    docker run --rm \
        -v "$HOST_MCP:/input.json:ro" \
        -v "$MCP_FRAGMENT:/fragment.json:ro" \
        "$BASE_IMAGE_NAME" node -e '
            const a = require("/input.json");
            const b = require("/fragment.json");
            const merged = { ...a, mcpServers: { ...a.mcpServers, ...b.mcpServers } };
            console.log(JSON.stringify(merged, null, 2));
        ' > "$MCP_TMP"
    VOLUMES+=(-v "$MCP_TMP:$CONFIG_PARENT/.mcp.json:ro")
elif [ -f "$MCP_FRAGMENT" ]; then
    cp "$MCP_FRAGMENT" "$MCP_TMP"
    VOLUMES+=(-v "$MCP_TMP:$CONFIG_PARENT/.mcp.json:ro")
elif [ -f "$HOST_MCP" ]; then
    VOLUMES+=(-v "$HOST_MCP:$CONFIG_PARENT/.mcp.json:ro")
fi


# ---------------------------------------------------------------------------
# Parse .claude-sandbox/ config cascade (memory limit, extra mounts, etc.)
# Every config.yaml from the filesystem root down to the project is merged:
# scalars/maps from more-local files override, mounts append (a same
# host+container entry overrides the upstream one). env files layer the same
# way (later --env-file wins); the child Dockerfile is nearest-wins (whole
# file, no merging).
# ---------------------------------------------------------------------------
mapfile -t CONFIG_FILES < <(cs_collect_up "$PROJECT_DIR" config)
mapfile -t ENV_FILES < <(cs_collect_up "$PROJECT_DIR" env)
MEMORY_LIMIT="8g"

# Show the cascade whenever any .claude-sandbox/ level contributes files.
if [ ${#CONFIG_FILES[@]} -gt 0 ] || [ ${#ENV_FILES[@]} -gt 0 ]; then
    echo "Sandbox config cascade (root → project; later overrides earlier):"
    _dir="$PROJECT_DIR"; _levels=()
    while [ "$_dir" != "/" ]; do
        [ -d "$_dir/.claude-sandbox" ] && _levels+=("$_dir")
        _dir="$(dirname "$_dir")"
    done
    for ((_i = ${#_levels[@]} - 1; _i >= 0; _i--)); do
        _lvl="${_levels[$_i]}"
        _has=()
        [ -f "$_lvl/.claude-sandbox/config.yaml" ] && _has+=("config.yaml")
        [ -f "$_lvl/.claude-sandbox/env" ]         && _has+=("env")
        [ -f "$_lvl/.claude-sandbox/Dockerfile" ]  && _has+=("Dockerfile (nearest wins)")
        [ ${#_has[@]} -gt 0 ] && echo "  $_lvl/.claude-sandbox/  →  ${_has[*]}"
    done
    unset _dir _levels _lvl _has _i
fi

YAML_SSH=""
YAML_GIT=""
YAML_DOCKER_SOCKET=""
YAML_AWS=""
YAML_MODEL=""
YAML_TRACK_IN_HOST=""

CONFIG_FILE=""
if [ ${#CONFIG_FILES[@]} -gt 0 ]; then
    if ! command -v yq &>/dev/null; then
        echo "Error: .claude-sandbox/config.yaml found but 'yq' is not installed." >&2
        echo "" >&2
        echo "yq is required to parse the config file. Install it with:" >&2
        echo "  brew install yq          # macOS (Homebrew)" >&2
        echo "  sudo snap install yq     # Ubuntu/Debian (snap)" >&2
        echo "  go install github.com/mikefarah/yq/v4@latest  # Go" >&2
        echo "" >&2
        echo "More options: https://github.com/mikefarah/yq#install" >&2
        exit 1
    fi

    # Merge the cascade into one effective config; all reads below use it.
    CONFIG_FILE="$(mktemp /tmp/claude-sandbox-config.XXXXXX.yaml)"
    # Re-arm the EXIT trap with the merged config included (traps don't stack).
    trap "rm -f '$CLAUDE_MD_TMP' '$SETTINGS_TMP' '$MCP_TMP' '$CONFIG_FILE'" EXIT
    cs_merge_configs "$CONFIG_FILE" "${CONFIG_FILES[@]}"
fi

if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ]; then

    # Memory limit (default: 8g)
    CONFIG_MEMORY=$(yq '.memoryLimit // ""' "$CONFIG_FILE")
    if [ -n "$CONFIG_MEMORY" ]; then
        MEMORY_LIMIT="$CONFIG_MEMORY"
    fi

    # Model override
    YAML_MODEL=$(yq '.model // ""' "$CONFIG_FILE")

    # Disable update check
    YAML_DISABLE_UPDATE_CHECK=$(yq '.disableUpdateCheck // ""' "$CONFIG_FILE")
    if [[ "$YAML_DISABLE_UPDATE_CHECK" = "true" && "$NO_UPDATE_CHECK" = "false" ]]; then
        NO_UPDATE_CHECK=true
    fi

    # Track the .claude-sandbox/ dir in the HOST repo (own projects) vs. keep it
    # gitignored with an internal sidecar repo (foreign repos, the safe default).
    YAML_TRACK_IN_HOST=$(yq '.trackInHost // ""' "$CONFIG_FILE")

    # Host access settings
    YAML_SSH=$(yq '.hostAccess.ssh.enabled // ""' "$CONFIG_FILE")
    YAML_GIT=$(yq '.hostAccess.git.enabled // ""' "$CONFIG_FILE")
    YAML_DOCKER_SOCKET=$(yq '.hostAccess.dockerSocket.enabled // ""' "$CONFIG_FILE")
    YAML_AWS=$(yq '.hostAccess.aws.enabled // ""' "$CONFIG_FILE")

    # Extra volume mounts
    MOUNT_COUNT=$(yq '.mounts | length' "$CONFIG_FILE")
    for ((i = 0; i < MOUNT_COUNT; i++)); do
        MOUNT_HOST=$(yq ".mounts[$i].host" "$CONFIG_FILE")
        MOUNT_CONTAINER=$(yq ".mounts[$i].container" "$CONFIG_FILE")
        MOUNT_WRITABLE=$(yq ".mounts[$i].writable // false" "$CONFIG_FILE")

        if [ "$MOUNT_HOST" = "null" ] || [ "$MOUNT_CONTAINER" = "null" ]; then
            echo "Error: mounts[$i] in the merged sandbox config requires both 'host' and 'container' fields" >&2
            echo "       (cascade: ${CONFIG_FILES[*]})" >&2
            exit 1
        fi

        # Skip mounts that duplicate the project directory (already mounted above)
        if [ "$MOUNT_CONTAINER" = "$PROJECT_DIR" ]; then
            echo "Skipping mounts[$i]: container path '$MOUNT_CONTAINER' duplicates project directory mount"
            continue
        fi

        if [ "$MOUNT_WRITABLE" = "true" ]; then
            VOLUMES+=(-v "$MOUNT_HOST:$MOUNT_CONTAINER")
        else
            VOLUMES+=(-v "$MOUNT_HOST:$MOUNT_CONTAINER:ro")
        fi
    done
fi

# ---------------------------------------------------------------------------
# Resolve host access flags: CLI > env var > YAML
# ---------------------------------------------------------------------------
resolve_flag() {
    local cli="$1" env="$2" yaml="$3"
    # CLI takes precedence
    if [[ -n "$cli" ]]; then echo "$cli"; return; fi
    # Then env var
    if [[ "$env" = "1" || "$env" = "true" || "$env" = "yes" ]]; then echo "true"; return; fi
    # Then YAML
    if [[ "$yaml" = "true" ]]; then echo "true"; return; fi
    echo "false"
}

# Resolve model: CLI > YAML
MODEL="${CLI_MODEL:-$YAML_MODEL}"

# Resolve trackInHost: YAML or default false. Controls whether .claude-sandbox/
# is tracked in the host repo (own projects) or gitignored with a sidecar repo.
TRACK_IN_HOST="${YAML_TRACK_IN_HOST:-false}"
[ "$TRACK_IN_HOST" = "true" ] || TRACK_IN_HOST="false"

SSH_MOUNT=$(resolve_flag "$CLI_SSH" "${CLAUDE_SANDBOX_HOST_ACCESS_SSH_ENABLED:-}" "$YAML_SSH")
GIT_MOUNT=$(resolve_flag "$CLI_GIT" "${CLAUDE_SANDBOX_HOST_ACCESS_GIT_ENABLED:-}" "$YAML_GIT")
DOCKER_SOCKET=$(resolve_flag "$CLI_DOCKER_SOCKET" "${CLAUDE_SANDBOX_HOST_ACCESS_DOCKER_SOCKET_ENABLED:-}" "$YAML_DOCKER_SOCKET")
AWS_MOUNT=$(resolve_flag "$CLI_AWS" "${CLAUDE_SANDBOX_HOST_ACCESS_AWS_ENABLED:-}" "$YAML_AWS")

# Host access volume mounts (now that flags are resolved)
if [ "$DOCKER_SOCKET" = true ]; then
    VOLUMES+=(-v /var/run/docker.sock:/var/run/docker.sock)
fi
if [ "$AWS_MOUNT" = true ] && [ -d "$HOME/.aws" ]; then
    VOLUMES+=(-v "$HOME/.aws:$HOME/.aws:ro")
fi

# Forward host AWS_* env vars when AWS access is enabled (e.g. direnv-set
# profile/credentials paths). Allowlist only — keeps the trust boundary
# explicit and avoids leaking arbitrary host env into the container.
# Path-valued vars (AWS_SHARED_CREDENTIALS_FILE, AWS_CONFIG_FILE) get a
# same-path read-only bind mount so they resolve inside the container.
AWS_ENV=()
if [ "$AWS_MOUNT" = true ]; then
    for v in AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION \
             AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE \
             AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
             AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_ENDPOINT_URL; do
        [ -n "${!v:-}" ] && AWS_ENV+=(-e "$v=${!v}")
    done
    for v in AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE AWS_WEB_IDENTITY_TOKEN_FILE; do
        path="${!v:-}"
        if [ -n "$path" ] && [ -f "$path" ]; then
            VOLUMES+=(-v "$path:$path:ro")
        elif [ -n "$path" ]; then
            echo "WARNING: $v=$path but file not found on host; skipping mount" >&2
        fi
    done
fi
if [ "$GIT_MOUNT" = true ] && [ -f "$HOME/.gitconfig" ]; then
    VOLUMES+=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
fi
if [ "$SSH_MOUNT" = true ] && [ -d "$HOME/.ssh" ]; then
    VOLUMES+=(-v "$HOME/.ssh:$HOME/.ssh:ro")
fi

DOCKER_GID=""
if [ "$DOCKER_SOCKET" = true ]; then
    DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo '')"
fi

# ---------------------------------------------------------------------------
# .claude-sandbox/ layout lifecycle (skeleton, gitignore, sidecar) — see lib
# ---------------------------------------------------------------------------
LAYOUT_MODE="$(cs_layout_mode "$PROJECT_DIR")"
# Greenfield (none) + ralph: adopt the layout so loop output lands in an ignored
# / sidecar'd dir from the first iteration. Interactive greenfield is left alone.
if [ "$LAYOUT_MODE" = "none" ] && [ "$RALPH_MODE" = true ]; then
    mkdir -p "$(cs_sandbox_dir "$PROJECT_DIR")"
    LAYOUT_MODE="new"
fi
if [ "$LAYOUT_MODE" = "new" ]; then
    cs_setup_layout "$PROJECT_DIR" "$TRACK_IN_HOST"
fi

# ---------------------------------------------------------------------------
# Resolve child Dockerfile (project-specific tools layer)
# Precedence: env var > .claude-sandbox/config.yaml > default
# ---------------------------------------------------------------------------
CONFIG_BASE_ONLY=""
CONFIG_DOCKERFILE_DIR=""
CONFIG_DOCKERFILE=""
if [ -f "$CONFIG_FILE" ]; then
    CONFIG_BASE_ONLY=$(yq '.baseOnly // ""' "$CONFIG_FILE")
    CONFIG_DOCKERFILE_DIR=$(yq '.dockerfileDir // ""' "$CONFIG_FILE")
    CONFIG_DOCKERFILE=$(yq '.dockerfile // ""' "$CONFIG_FILE")
fi

BASE_ONLY="${CLAUDE_SANDBOX_BASE_ONLY:-$CONFIG_BASE_ONLY}"

# An explicit override (env var or yaml dockerfileDir/dockerfile) bypasses the
# resolver and is honored verbatim — build context stays the override directory,
# preserving the historical behavior for advanced users.
DOCKERFILE_OVERRIDE=false
if [ -n "${CLAUDE_SANDBOX_DOCKERFILE_DIR:-}" ] || [ -n "${CLAUDE_SANDBOX_DOCKERFILE:-}" ] \
   || [ -n "$CONFIG_DOCKERFILE_DIR" ] || [ -n "$CONFIG_DOCKERFILE" ]; then
    DOCKERFILE_OVERRIDE=true
fi

CHILD_DOCKERFILE_DIR="${CLAUDE_SANDBOX_DOCKERFILE_DIR:-${CONFIG_DOCKERFILE_DIR:-$PROJECT_DIR}}"
CHILD_DOCKERFILE_NAME="${CLAUDE_SANDBOX_DOCKERFILE:-${CONFIG_DOCKERFILE:-Dockerfile}}"
CHILD_DOCKERFILE="${CHILD_DOCKERFILE_DIR}/${CHILD_DOCKERFILE_NAME}"
# Build context defaults to the Dockerfile's directory (historical behavior).
CHILD_BUILD_CONTEXT="$CHILD_DOCKERFILE_DIR"

if [ "$DOCKERFILE_OVERRIDE" = false ]; then
    # No override: the child Dockerfile is .claude-sandbox/Dockerfile, but the
    # build context stays the PROJECT ROOT so COPY instructions still reference
    # the project (as the example documents).
    CHILD_DOCKERFILE="$(cs_resolve "$PROJECT_DIR" dockerfile)"
    CHILD_DOCKERFILE_NAME="$(basename "$CHILD_DOCKERFILE")"
    CHILD_DOCKERFILE_DIR="$(dirname "$CHILD_DOCKERFILE")"
    CHILD_BUILD_CONTEXT="$PROJECT_DIR"
fi

USE_CHILD=false
if [ "$BASE_ONLY" = "true" ] || [ "$BASE_ONLY" = "1" ]; then
    USE_CHILD=false
elif [ -f "$CHILD_DOCKERFILE" ]; then
    USE_CHILD=true
elif [ "$DOCKERFILE_OVERRIDE" = true ]; then
    # Override path: walk parents for the exact override filename
    _found="$(find_up "$(dirname "$CHILD_DOCKERFILE_DIR")" "$CHILD_DOCKERFILE_NAME")"
    if [ -n "$_found" ]; then
        CHILD_DOCKERFILE_DIR="$(dirname "$_found")"
        CHILD_DOCKERFILE="$_found"
        CHILD_BUILD_CONTEXT="$CHILD_DOCKERFILE_DIR"
        USE_CHILD=true
        echo "Found $CHILD_DOCKERFILE_NAME in parent directory: $CHILD_DOCKERFILE_DIR"
    fi
else
    # No override: walk parents for a .claude-sandbox/Dockerfile. The build
    # context is the repo root that holds it (the parent of the .claude-sandbox/
    # dir) so COPY instructions still reference the project.
    _found="$(cs_find_up "$(dirname "$PROJECT_DIR")" dockerfile)"
    if [ -n "$_found" ]; then
        CHILD_DOCKERFILE="$_found"
        CHILD_DOCKERFILE_NAME="$(basename "$_found")"
        CHILD_DOCKERFILE_DIR="$(dirname "$_found")"
        CHILD_BUILD_CONTEXT="$(dirname "$CHILD_DOCKERFILE_DIR")"
        USE_CHILD=true
        echo "Found $CHILD_DOCKERFILE_NAME in parent directory: $CHILD_BUILD_CONTEXT"
    fi
fi

# ---------------------------------------------------------------------------
# Build child image if a project Dockerfile exists, or fall back to base
# ---------------------------------------------------------------------------
PROJECT_SLUG="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g')"

if [ "$USE_CHILD" = true ]; then
    CHILD_IMAGE_NAME="claude-sandbox-${PROJECT_SLUG}"

    CHILD_NEEDS_BUILD=false
    if ! docker image inspect "$CHILD_IMAGE_NAME" >/dev/null 2>&1; then
        CHILD_NEEDS_BUILD=true
    elif [ "$BASE_NEEDS_BUILD" = true ]; then
        # Base was rebuilt — child must be rebuilt too
        CHILD_NEEDS_BUILD=true
    else
        _img_created=$(docker image inspect -f '{{.Created}}' "$CHILD_IMAGE_NAME" 2>/dev/null || echo "")
        if [ -n "$_img_created" ]; then
            _marker=$(mktemp)
            touch -d "$_img_created" "$_marker" 2>/dev/null || true
            if [ "$CHILD_DOCKERFILE" -nt "$_marker" ]; then
                CHILD_NEEDS_BUILD=true
            else
                # Base image rebuilt out-of-band (in a prior launch / manually) is
                # newer than the child — the child still carries the old base's
                # layers (e.g. a stale entrypoint), so rebuild it.
                _base_created=$(docker image inspect -f '{{.Created}}' "$BASE_IMAGE_NAME" 2>/dev/null || echo "")
                if [ -n "$_base_created" ]; then
                    _base_marker=$(mktemp)
                    touch -d "$_base_created" "$_base_marker" 2>/dev/null || true
                    if [ "$_base_marker" -nt "$_marker" ]; then
                        echo "Base image is newer than child — rebuilding child."
                        CHILD_NEEDS_BUILD=true
                    fi
                    rm -f "$_base_marker"
                fi
            fi
            rm -f "$_marker"
        fi
    fi

    if [ "$CHILD_NEEDS_BUILD" = true ]; then
        echo "Building $CHILD_IMAGE_NAME child image from $CHILD_DOCKERFILE (context: $CHILD_BUILD_CONTEXT)..."
        docker build -t "$CHILD_IMAGE_NAME" -f "$CHILD_DOCKERFILE" "$CHILD_BUILD_CONTEXT"
    fi

    IMAGE_NAME="$CHILD_IMAGE_NAME"
else
    if [ "$BASE_ONLY" != "true" ] && [ "$BASE_ONLY" != "1" ]; then
        echo "WARNING: No child Dockerfile found at $CHILD_DOCKERFILE" >&2
        echo "  Project-specific tools (Go, TypeScript LSP, etc.) will not be available." >&2
        echo "  Create .claude-sandbox/Dockerfile to add them, or set baseOnly: true" >&2
        echo "  in your config to suppress this warning." >&2
        echo "" >&2
    fi
    IMAGE_NAME="$BASE_IMAGE_NAME"
fi

# ---------------------------------------------------------------------------
# Claude environment file (Discord webhook, etc.)
# ---------------------------------------------------------------------------
# ENV_FILES collected with the config cascade above (root-first). Docker applies
# --env-file flags in order, so later (more local) files override earlier ones.
if [ ${#ENV_FILES[@]} -gt 0 ]; then
    ENV_ARGS=()
    for _ef in "${ENV_FILES[@]}"; do
        ENV_ARGS+=(--env-file "$_ef")
    done
    unset _ef
else
    ENV_ARGS=()
    echo "WARNING: env file not found (.claude-sandbox/env) in $PROJECT_DIR or any parent" >&2
    echo "" >&2
    echo "This file provides environment variables needed by Claude Code" >&2
    echo "(e.g. DISCORD_WEBHOOK_URL for MCP server notifications)." >&2
    echo "" >&2
    echo "To create it, bootstrap the project and fill in your values:" >&2
    echo "  claude-sandbox init   # creates .claude-sandbox/env (and config)" >&2
fi

# ---------------------------------------------------------------------------
# Build container command
# ---------------------------------------------------------------------------
if [ "$RALPH_MODE" = true ]; then
    CONTAINER_NAME="claude-sandbox-${PROJECT_SLUG}-ralph"
    CMD=("/opt/claude-sandbox/bin/ralph")
    [[ -n "$LIMIT" ]] && CMD+=("--limit" "$LIMIT")
    [[ -n "$SKIP_PERMISSIONS" ]] && CMD+=("$SKIP_PERMISSIONS")
    [[ -n "$MODEL" ]] && CMD+=("--model" "$MODEL")
    CMD+=("$@")
else
    CONTAINER_NAME="claude-sandbox-${PROJECT_SLUG}"
    CMD=("claude")
    [[ -n "$SKIP_PERMISSIONS" ]] && CMD+=("$SKIP_PERMISSIONS")
    [[ -n "$MODEL" ]] && CMD+=("--model" "$MODEL")
    CMD+=("$@")
fi

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------
CLAUDE_CONFIG_DIR_ENV=()
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    CLAUDE_CONFIG_DIR_ENV=(-e "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR")
fi

exec docker run -it --rm --init \
    "${VOLUMES[@]}" \
    -w "$PROJECT_DIR" \
    "${ENV_ARGS[@]}" \
    --memory "$MEMORY_LIMIT" \
    --memory-swap "$MEMORY_LIMIT" \
    -e HOST_UID="$HOST_UID" \
    -e HOST_GID="$HOST_GID" \
    -e HOST_USER="$(whoami)" \
    -e HOST_HOME="$HOME" \
    -e HOME="$HOME" \
    -e DOCKER_GID="$DOCKER_GID" \
    -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
    "${CLAUDE_CONFIG_DIR_ENV[@]}" \
    "${AWS_ENV[@]}" \
    --name "$CONTAINER_NAME" \
    "$IMAGE_NAME" \
    "${CMD[@]}"
