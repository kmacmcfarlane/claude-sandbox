#!/usr/bin/env bash
#
# claude-sandbox — thin bootstrap shim.
#
# The launcher is a Go binary (cmd/claude-sandbox). This shim keeps the
# clone-and-run install model: it (re)builds the binary when sources are newer
# than the cached build — using the host Go toolchain when available, else a
# throwaway `docker run golang` so the host needs only bash + docker — then
# execs it. All behavior lives in the binary (see spec/*.feature).
#
set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"
BIN_DIR="$REPO_ROOT/bin/dist"
BIN="$BIN_DIR/claude-sandbox"
GO_IMAGE="golang:1.25-bookworm"

# Sources whose changes require a rebuild of the binary.
SOURCES=(cmd internal assets.go go.mod go.sum scaffold scaffold-ralph
         container-context.md notification-hooks.json mcp-servers.json PROMPT_RALPH.md)

# stale: the binary is missing, or a source is newer than it.
stale() {
    [ -x "$BIN" ] || return 0
    local src p
    for src in "${SOURCES[@]}"; do
        p="$REPO_ROOT/$src"
        [ -e "$p" ] || continue
        if [ -n "$(find "$p" -newer "$BIN" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

# Shell completion (spec/completion.feature CS-COMP-022/023): the generated
# scripts call these hidden commands on every TAB. A keystroke must never block
# on a compile or a docker image pull, so serve them from whatever binary is
# already built — slightly stale completions beat a hung prompt — and exit
# quietly if nothing has been built yet.
case "${1-}" in
    __complete | __completeNoDesc)
        [ -x "$BIN" ] || exit 1
        export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
        exec -a claude-sandbox "$BIN" "$@"
        ;;
    tmux)
        # The tmux-resurrect hooks (spec/tmux.feature CS-TMUX-003, CS-TMUX-068)
        # run synchronously inside resurrect: the save hook inside every save,
        # continuum's minute autosave included, and "tmux restore --pin" /
        # "--rearm" inside every restore, at boot too. They must never build
        # (unbounded, and it prints), never wait on the build lock and never
        # print. A stale binary is skipped too, not run: one from before a hook
        # existed would read it as a prompt and launch a session. The next
        # ordinary launch rebuilds, and the hooks pick up again.
        # "tmux restore --resurrected" is not a hook: resurrect types it into a
        # pane's shell, and it builds (under the lock below) like any launch.
        if [ "${2-}" = save ] || { [ "${2-}" = restore ] && { [ "${3-}" = --pin ] || [ "${3-}" = --rearm ]; }; }; then
            stale && exit 0
            export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
            exec -a claude-sandbox "$BIN" "$@" >/dev/null 2>&1
        fi
        ;;
esac

# build: compile bin/dist/claude-sandbox with the host go, else docker golang.
# Output goes to stderr: stdout belongs to claude in headless mode. fd 9 (the
# build lock, below) is closed for the build commands: a lock is held by the
# open file description, so the shim keeps it either way, and nothing the
# build leaves behind can hold it after the shim is gone.
build() {
    mkdir -p "$BIN_DIR"
    if command -v go >/dev/null 2>&1; then
        echo "Building claude-sandbox binary (host go)..." >&2
        (cd "$REPO_ROOT" && CGO_ENABLED=0 go build -o "$BIN" ./cmd/claude-sandbox) >&2 9>&-
    else
        echo "Building claude-sandbox binary (docker $GO_IMAGE)..." >&2
        # Persist the build AND module caches under bin/dist/ (gitignored), so a
        # throwaway build container downloads each dependency only once.
        # stdout goes to stderr: in headless mode stdout is claude's stream-json
        # (a first pull prints progress there).
        mkdir -p "$BIN_DIR/gocache" "$BIN_DIR/gomodcache"
        docker run --rm \
            -u "$(id -u):$(id -g)" \
            -e HOME=/tmp -e CGO_ENABLED=0 \
            -e GOCACHE=/src/bin/dist/gocache \
            -e GOMODCACHE=/src/bin/dist/gomodcache \
            -v "$REPO_ROOT:/src" -w /src \
            "$GO_IMAGE" go build -o bin/dist/claude-sandbox ./cmd/claude-sandbox >&2 9>&-
    fi
}

# Builds serialise on a lock (spec/tmux.feature CS-TMUX-073): tmux-continuum's
# boot restore types into every pane within a second, and after a pull each
# shim would otherwise start its own build onto the same output path. Only a
# stale binary takes the lock — an up-to-date launch never touches it — and
# staleness is checked again under it, so a waiter execs what the holder just
# built instead of building it again. The lock file sits beside the binary in
# bin/dist/ (gitignored, the shim's own build dir, per checkout: two checkouts
# build two binaries and need not wait for each other). The wait is bounded:
# a hung build (a stuck `docker run golang` pull) must not hold every pane
# forever, so past BUILD_LOCK_WAIT seconds a waiter warns and builds unlocked,
# which is what every shim did before the lock (CLAUDE_SANDBOX_BUILD_LOCK_WAIT,
# a whole number of seconds, overrides the 600; anything else is ignored). A
# holder whose build fails leaves the binary stale, so each waiter then builds
# in turn: N failing builds for N panes, each still one at a time. Without flock (util-linux;
# macOS has none) or when the lock file cannot be opened, the shim builds
# unlocked, as before, with no message. The hook fast paths above never reach
# this point, so they never build and never wait.
BUILD_LOCK_WAIT=600
case "${CLAUDE_SANDBOX_BUILD_LOCK_WAIT-}" in
    '' | *[!0-9]*) ;;
    *) BUILD_LOCK_WAIT=$CLAUDE_SANDBOX_BUILD_LOCK_WAIT ;;
esac
if stale; then
    locked=false
    if command -v flock >/dev/null 2>&1 \
        && mkdir -p "$BIN_DIR" 2>/dev/null \
        && { exec 9>>"$BIN_DIR/.build.lock"; } 2>/dev/null; then
        if flock -n 9 2>/dev/null; then
            locked=true
        else
            echo "Waiting for another claude-sandbox build to finish..." >&2
            if flock -w "$BUILD_LOCK_WAIT" 9 2>/dev/null; then
                locked=true
            else
                echo "WARNING: the other claude-sandbox build still holds $BIN_DIR/.build.lock after ${BUILD_LOCK_WAIT}s; building without the lock." >&2
            fi
        fi
    fi
    if [ "$locked" = false ] || stale; then
        build
    fi
    # Release the lock and close the fd so neither reaches the exec'd binary.
    # Only "9>&-": any other redirection on a bare exec would stay applied to
    # the shell, and so to the launcher it execs (a "2>/dev/null" here once
    # silenced every stale launch's stderr). Closing a closed fd succeeds.
    exec 9>&-
fi

export CLAUDE_SANDBOX_REPO_ROOT="$REPO_ROOT"
# argv[0] is "claude-sandbox", not the bin/dist path (spec/tmux.feature
# CS-TMUX-001/002): tmux-resurrect saves the full command line and its
# @resurrect-processes entries match only the first word (`^name ` /
# `^name$`), which the bin/dist path (possibly containing a space) never
# matched. The binary never derives anything from argv[0] but the "ralph"
# switch; its repo root comes from CLAUDE_SANDBOX_REPO_ROOT.
exec -a claude-sandbox "$BIN" "$@"
